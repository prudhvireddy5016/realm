.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Docker / VCS
Dockerfile
.dockerignore
.git/
.gitignore

# Logs, editors, OS
*.log
.vscode/
.idea/
*.swp
.DS_Store
